# Copy to .env.test for running `pnpm test:e2e` locally against a dedicated test
# database (kept separate from the dev database so e2e runs never touch your
# local dev data). One-time setup:
#   docker exec beaconvie-postgres psql -U beaconvie -d beaconvie -c "CREATE DATABASE beaconvie_test;"
#   DATABASE_URL=postgresql://beaconvie:beaconvie_dev_password@localhost:5433/beaconvie_test?schema=public pnpm --filter @beaconvie/api exec prisma migrate deploy

NODE_ENV=test
API_PORT=4001
API_BASE_URL=http://localhost:4001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://beaconvie:beaconvie_dev_password@localhost:5433/beaconvie_test?schema=public
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=test-only-access-secret-not-for-production-use-xxxxx
JWT_REFRESH_SECRET=test-only-refresh-secret-not-for-production-use-xxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

PASSWORD_RESET_EXPIRES_IN=1h

MAIL_PROVIDER=mailpit
MAIL_FROM="BeaconVie Test <no-reply@beaconvie.local>"
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Higher than the production default so a full e2e run (many forgot-password
# calls across multiple tests) doesn't trip the rate limiter itself.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
