# --- Server ---
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Fixed base URL used to build every link inside an email (verify-email,
# reset-password) — kept separate from FRONTEND_URL to prevent open-redirect
# drift if FRONTEND_URL is ever widened. Optional in dev (falls back to
# FRONTEND_URL); required in production.
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Host port 5433 (not 5432) to avoid clashing with any other local Postgres — see docker-compose.yml
DATABASE_URL=postgresql://beaconvie:beaconvie_dev_password@localhost:5433/beaconvie?schema=public

# --- Redis ---
# Host port 6380 (not 6379) to avoid clashing with any other local Redis — see docker-compose.yml
REDIS_URL=redis://localhost:6380

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CSRF ---
# Generate with: openssl rand -base64 48
CSRF_SECRET=replace-with-a-long-random-secret-min-32-chars

# --- Auth cookies ---
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# --- Password reset ---
PASSWORD_RESET_EXPIRES_IN=1h

# --- Email verification ---
EMAIL_VERIFICATION_EXPIRES_IN=24h
EMAIL_VERIFICATION_RESEND_COOLDOWN=60s

# --- Mail ---
# mailpit (local dev only) | resend | postmark — production must not use mailpit.
EMAIL_PROVIDER=mailpit
EMAIL_FROM="BeaconVie <no-reply@beaconvie.local>"
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
# Required if EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# Required if EMAIL_PROVIDER=postmark
# POSTMARK_SERVER_TOKEN=

# --- Rate limiting ---
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_REDIS_PREFIX=beaconvie:throttle

# --- Reverse proxy trust ---
# 'false' (default, no proxy) | 'true' (trust nearest hop) | a number of hops.
# Only enable behind a known reverse proxy — see apps/api/src/main.ts.
TRUST_PROXY=false

# --- Sessions ---
# Optional cap on concurrent active sessions per user; unset = unlimited.
# SESSION_MAX_ACTIVE=10

# --- Companion Core (AI conversation layer) ---
# mock is the only provider that needs no key — use it for local dev/CI/tests.
# Production may not select mock, may not set FALLBACK_PROVIDER=mock, and may
# not set AI_ENABLE_MOCK_PROVIDER=true (env.validation.ts fails fast on boot
# for all three — see docs/security/ai-safety.md "Mock provider").
#
# IMPORTANT (Sprint 8.5 remediation finding): setting OPENAI_API_KEY (or
# ANTHROPIC_API_KEY / GEMINI_API_KEY) below does NOT, by itself, make that
# provider active. DEFAULT_AI_PROVIDER is the sole switch that selects which
# provider actually handles Companion/Tarot/Numerology generation — leaving
# it at the "mock" default here while a real key is configured elsewhere
# silently runs the entire product on the deterministic Mock provider with no
# error, no warning beyond the safe "AI provider: mock" line main.ts logs at
# boot. If you want real AI locally, you must explicitly set this to the
# provider whose key you configured, e.g.:
DEFAULT_AI_PROVIDER=mock
# Optional — tried if the default provider's retries are exhausted.
# FALLBACK_PROVIDER=mock
# Required only if DEFAULT_AI_PROVIDER or FALLBACK_PROVIDER selects that provider.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Explicit opt-in for the Mock provider to be registered at all — outside
# production this is effectively moot (mock registers automatically whenever
# NODE_ENV != production); production always rejects it regardless.
AI_ENABLE_MOCK_PROVIDER=false

# --- Companion Core: rate limiting, concurrency, usage budget ---
# Per-user request rate limit on sending a Companion message.
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
# Secondary, looser per-IP ceiling — defense against one IP spread across many accounts.
AI_RATE_LIMIT_IP_MAX=100
# How many generations one user may have in flight at once.
AI_MAX_CONCURRENT_GENERATIONS_PER_USER=1
# Safety-net TTL so a missed lock release self-expires rather than blocking a user forever.
AI_CONCURRENCY_LOCK_TTL_MS=120000
# Coarse daily/monthly abuse and cost ceilings, independent of the rate limit above. GLOBAL per
# user across every AI feature (Companion + Discovery combined) — see CostControlService.checkBudget.
AI_DAILY_REQUEST_LIMIT=50
AI_DAILY_TOKEN_LIMIT=200000
AI_MONTHLY_TOKEN_LIMIT=2000000

# --- Discovery AI cost-control parity (Sprint 12) — Tarot/Numerology/Natal Chart's own rate-limit
# bucket, isolated from `companion`/`auth`/`payment`. Tighter default than Companion's (a Discovery
# interpret call is one heavier generation, not a chat message) — see
# docs/architecture/discovery-ai-cost-control.md.
DISCOVERY_RATE_LIMIT_MAX=10
DISCOVERY_RATE_LIMIT_WINDOW_MS=60000
DISCOVERY_RATE_LIMIT_IP_MAX=50

# --- Memory Intelligence (Sprint 3B) — deterministic context token budgeting for the
# retrieval policy. Token counts are estimated (chars/4 heuristic), not a real tokenizer.
MEMORY_CONTEXT_WINDOW_TOKENS=8000
MEMORY_CONTEXT_RESERVED_OUTPUT_TOKENS=1024
MEMORY_CONTEXT_CONVERSATION_MAX_TOKENS=3000
MEMORY_CONTEXT_MEMORY_MAX_TOKENS=1500

# --- Premium & Payment Foundation (Sprint 7) ---
# PayOS merchant credentials — https://payos.vn merchant dashboard. Required in production.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# Signs checkout requests and verifies webhook signatures — server-only, never logged, never
# exposed to the client.
# PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
# Outside production only: short-circuits the outbound "create checkout link" HTTP call to PayOS
# with a locally-built response (still real-signature) so checkout works without live PayOS
# credentials. Webhook signature verification is never mocked. Production boot fails if true.
PAYOS_MOCK_CHECKOUT=false
# Payment kill switch (PayOS Production Readiness Gate) — set to false to disable *new* checkout
# creation without a redeploy. Existing Premium entitlements are unaffected, and already-created
# orders may still legitimately complete: the PayOS webhook route always keeps processing
# regardless of this flag. See docs/progress/payos-production-readiness.md "Payment kill switch".
PAYMENTS_ENABLED=true
# Single MVP product: a 30-day Premium pass. No pricing figure exists in the Product Bible yet —
# this is a placeholder business assumption, not a validated price point.
PREMIUM_PRICE_VND=79000
PREMIUM_DURATION_DAYS=30
# Checkout/order-creation throttle — isolated from the `companion`/`auth` buckets (see
# PaymentThrottlerGuard) so it is neither too strict nor accidentally shares a bucket with them.
PAYMENT_RATE_LIMIT_MAX=10
PAYMENT_RATE_LIMIT_WINDOW_MS=60000

# --- Natal Chart Discovery Foundation (Sprint 9) — geocoding ---
# Public Nominatim (OpenStreetMap) — appropriate for MVP/low-volume use. Overridable to a hosted/
# self-hosted instance at production scale without a code change. See
# docs/architecture/natal-chart-discovery.md "Geocoding architecture".
GEOCODING_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Required by Nominatim's usage policy — identifies this app on every request.
GEOCODING_USER_AGENT=BeaconVie/1.0 (natal-chart-geocoding)
GEOCODING_TIMEOUT_MS=8000
# How long a search result candidate stays resolvable by its opaque token before chart creation
# must search again.
GEOCODING_CANDIDATE_TTL_SECONDS=900

# --- Production error tracking (Sprint 12) — optional, error-tracking tier only (no performance
# tracing/profiling/session replay). Absent = Sentry fully disabled, API boots normally either
# way. A DSN is a write-only ingestion identifier, not a secret credential. See
# docs/architecture/observability.md.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- Product Analytics (Sprint 13) — optional, mirrors SENTRY_DSN's contract: absent key =
# analytics fully disabled, API boots normally either way. See docs/architecture/product-analytics.md.
# POSTHOG_API_KEY=phc_examplePublicProjectKey
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_ENABLED=true
