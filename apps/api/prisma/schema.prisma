// BeaconVie — Sprint 1 data model.
// Design notes:
// - IDs use cuid() for URL-safe, sortable, non-guessable identifiers.
// - Refresh tokens and password-reset tokens are stored only as hashes, never plaintext.
// - Companion messages (onboarding + post-onboarding) share one table (`CompanionMessage`),
//   tagged by `context`, per docs/reference Module 7 §16: onboarding is not a separate AI
//   pathway, it is the first turns of the same ongoing relationship.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  passwordHash          String
  displayName           String
  status                UserStatus @default(ACTIVE)
  emailVerifiedAt       DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  sessions                UserSession[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  profile                 UserProfile?
  preference              UserPreference?
  onboardingProgress      OnboardingProgress?
  activityEvents          ActivityEvent[]
  memoryNotes             MemoryNote[]
  companionMessages       CompanionMessage[]
  conversations           Conversation[]
  aiUsages                AIUsage[]
  memories                Memory[]
  memoryCandidates        MemoryCandidate[]
  memoryConsentSetting    MemoryConsentSetting?
  memoryTypeConsents      MemoryTypeConsent[]
  memoryAudits            MemoryAudit[]
  memoryDuplicates        MemoryDuplicate[]
  memoryConflicts         MemoryConflict[]
  memoryMergeSuggestions  MemoryMergeSuggestion[]
  memoryRetrievalLogs     MemoryRetrievalLog[]
  journalEntries          JournalEntry[]
  reflectionCandidates    ReflectionCandidate[]
  insightCandidates       InsightCandidate[]
  insightRelationships    InsightRelationship[]
  reviews                 Review[]
  goals                   Goal[]
  tarotReadings           TarotReading[]
  paymentOrders           PaymentOrder[]
  premiumEntitlements     PremiumEntitlement[]
  numerologyReadings      NumerologyReading[]
  natalCharts             NatalChart[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?

  @@map("users")
}

/// One row per active refresh-token session ("device"). Refresh tokens rotate on
/// every use; `familyId` links every rotation of the same original login together so
/// reuse of an already-rotated token can revoke the whole family (theft response).
model UserSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  familyId         String
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Hash-only, single-use, expiring — same shape as PasswordResetToken. One row
/// per issued verification email; the most recent row's createdAt is used to
/// enforce the resend cooldown (Sprint 2A).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("email_verification_tokens")
}

/// Profile fields are never collected via a required form (docs/reference Module 6 §8,
/// Module 7 §7) — they are inferred (timezone/locale from the browser) or volunteered
/// conversationally, and remain editable later in Settings.
model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pronouns  String?
  timezone  String?
  locale    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

enum MemoryPreference {
  ASK_BEFORE_SAVING
  SAVE_SELECTED_ONLY
  DO_NOT_SAVE_YET
}

enum ReflectionFrequency {
  DAILY
  FEW_TIMES_A_WEEK
  WEEKLY
  NOT_SURE_YET
}

model UserPreference {
  id                        String              @id @default(cuid())
  userId                    String              @unique
  user                      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryPreference          MemoryPreference    @default(ASK_BEFORE_SAVING)
  reflectionFrequency       ReflectionFrequency @default(NOT_SURE_YET)
  checkInTime               String?
  /// Sprint 4A — "Never suggest again" on a Companion journal suggestion. A single toggle, not a
  /// per-type consent table like Memory's: journal suggestions come from one deterministic
  /// detector, not eighteen memory types, so there is no per-type dimension to gate.
  journalSuggestionsEnabled Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@map("user_preferences")
}

enum OnboardingStage {
  WELCOME
  MEET_COMPANION
  CONVERSATION
  REFLECTION
  DISCOVERY_CHOICE
  ACTIVATION
  SUCCESS
}

enum OnboardingDiscoveryChoice {
  ACCEPTED
  SKIPPED
}

model OnboardingProgress {
  id              String                     @id @default(cuid())
  userId          String                     @unique
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage           OnboardingStage            @default(WELCOME)
  discoveryChoice OnboardingDiscoveryChoice?
  completedAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@map("onboarding_progress")
}

enum MessageRole {
  USER
  COMPANION
}

enum MessageContext {
  ONBOARDING
  COMPANION
}

/// Sprint 2B note: the post-onboarding rule-based Companion (context=COMPANION)
/// was replaced in place by the real `Conversation`/`ConversationMessage` model
/// below — see the Sprint 2B migration, which copies every existing
/// context=COMPANION row into a `Conversation` per user (data preserved, not
/// deleted). Onboarding's own conversational turns (context=ONBOARDING) are
/// untouched and still write here — this table is not being retired, only the
/// COMPANION half of its use is dormant going forward.
model CompanionMessage {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  context   MessageContext
  createdAt DateTime       @default(now())

  @@index([userId, createdAt])
  @@map("companion_messages")
}

enum MemorySource {
  ONBOARDING
  COMPANION
}

model MemoryNote {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  source    MemorySource
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
  @@map("memory_notes")
}

enum ActivityType {
  ACCOUNT_CREATED
  ONBOARDING_COMPLETED
  PREFERENCE_UPDATED
  MEMORY_CREATED
  EMAIL_VERIFIED
  PASSWORD_CHANGED
  SESSION_REVOKED
  LOGOUT_ALL
}

/// Minimal, non-sensitive metadata only — never store message content or other
/// personal disclosures here (docs/reference Sprint 1 requirement).
model ActivityEvent {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ActivityType
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
  @@map("activity_events")
}

// ---------------------------------------------------------------------------
// Sprint 2B — Companion Core (real AI conversation layer). Explicitly NOT a
// Memory Engine: no embeddings, no vector storage, no semantic search here.
// See docs/architecture/companion-core.md.
// ---------------------------------------------------------------------------

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum ConversationRole {
  SYSTEM
  USER
  ASSISTANT
}

enum AIProviderName {
  OPENAI
  ANTHROPIC
  GEMINI
  MOCK
}

model Conversation {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  messages ConversationMessage[]
  usages   AIUsage[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

/// `metadata` carries non-sensitive generation facts only (provider, model,
/// cancelled/safety-refused flags) — never raw provider request/response
/// payloads. `content` is the only place message text itself lives.
model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ConversationRole
  content        String
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

/// One row per completed (or cancelled) assistant generation — the basis for
/// cost control's daily/monthly/per-user aggregates. `estimatedCostUsd` is an
/// estimate from the provider pricing table, not a billing record.
model AIUsage {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId   String?
  conversation     Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  provider         AIProviderName
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCostUsd Decimal        @db.Decimal(10, 6)
  createdAt        DateTime       @default(now())

  @@index([userId, createdAt])
  @@map("ai_usages")
}

/// AI observability trail — deliberately excludes conversation content, PII,
/// and any request/response body. See docs/security/ai-safety.md "Observability".
model ProviderLog {
  id               String         @id @default(cuid())
  provider         AIProviderName
  model            String
  latencyMs        Int
  success          Boolean
  errorCode        String?
  retryCount       Int            @default(0)
  streamDurationMs Int?
  createdAt        DateTime       @default(now())

  @@index([provider, createdAt])
  @@map("provider_logs")
}

// ---------------------------------------------------------------------------
// Sprint 3A — Memory Foundation. Structural trust layer only: schema, consent,
// candidate lifecycle, CRUD, versioning, audit, timeline, export. Explicitly
// NOT Memory intelligence — no embeddings, no vector search, no RAG, no
// knowledge graph, no LLM extraction, no importance/duplicate/merge automation.
// See docs/architecture/memory-engine.md and docs/security/memory-privacy.md.
//
// Distinct from Sprint 1's `MemoryNote` (kept, deprecated — see the data
// migration in this sprint's first migration file) and from
// `UserPreference.memoryPreference` (Sprint 1's onboarding-level global
// toggle, left untouched — a separate, older setting for a separate flow).
// ---------------------------------------------------------------------------

enum MemoryType {
  IDENTITY
  PREFERENCE
  GOAL
  RELATIONSHIP
  HABIT
  ROUTINE
  ACHIEVEMENT
  CHALLENGE
  EMOTION
  IMPORTANT_EVENT
  DECISION
  INTEREST
  WORK
  STUDY
  PET
  LOCATION_PREFERENCE
  /// Never enabled implicitly — gated by an explicit MemoryTypeConsent row with mode ALLOW_TYPE. See memory-privacy.md.
  HEALTH
  CUSTOM
}

enum MemoryStatus {
  CANDIDATE
  PENDING_CONSENT
  ACCEPTED
  REJECTED
  ARCHIVED
  EXPIRED
  DELETED
}

/// Per (user, type) — and, via MemoryConsentSetting, one global per-user default.
enum MemoryConsentMode {
  ASK_EVERY_TIME
  ALLOW_SELECTED
  ALLOW_TYPE
  DENY_TYPE
  DISABLED
}

enum MemoryVisibility {
  PRIVATE
  COMPANION_ALLOWED
}

/// How a Memory or MemoryCandidate came to exist — always a real, attributable origin.
enum MemorySourceType {
  ONBOARDING
  COMPANION
  USER_EXPLICIT
  MIGRATED_LEGACY
  SYSTEM_TEST
}

enum MemoryCandidateStatus {
  CANDIDATE
  PENDING_CONSENT
  ACCEPTED
  REJECTED
}

enum MemoryAuditAction {
  CREATED
  ACCEPTED
  REJECTED
  UPDATED
  ARCHIVED
  RESTORED
  DELETED
  CONSENT_CHANGED
  VIEWED
  EXPORTED
}

enum MemoryActorType {
  USER
  SYSTEM
  COMPANION
}

/// One row per user — the global default consent mode applied whenever no
/// per-type MemoryTypeConsent override exists. Deliberately a single-row-per-user
/// table (not a nullable-type row in MemoryTypeConsent) so "no override set" is
/// unambiguous and Postgres NULL-in-unique-index pitfalls never arise.
model MemoryConsentSetting {
  id        String            @id @default(cuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      MemoryConsentMode @default(ASK_EVERY_TIME)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("memory_consent_settings")
}

/// Explicit per-type override. Absence of a row for a given type means "use
/// the global MemoryConsentSetting" — a type is never auto-allowed by default.
model MemoryTypeConsent {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      MemoryType
  mode      MemoryConsentMode
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, type])
  @@index([userId])
  @@map("memory_type_consents")
}

/// A proposed memory awaiting consent/acceptance. Never becomes a Memory on
/// its own — only MemoryCandidateService.accept() (consent-checked, atomic
/// with the first MemoryVersion) creates one. See memory-engine.md "Candidate
/// lifecycle" for the exhaustive list of legitimate creation paths — there is
/// no unauthenticated or unattributed way to create one.
model MemoryCandidate {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposedType         MemoryType
  proposedTitle        String
  proposedSummary      String
  structuredPayload    Json?
  sourceType           MemorySourceType
  /// Plain string references, not enforced FKs — Conversation/ConversationMessage
  /// belong to the Companion module; ownership is verified in application code
  /// at proposal time (never trusted from the client), not via a DB constraint.
  sourceConversationId String?
  sourceMessageId      String?
  reason               String?
  status               MemoryCandidateStatus @default(CANDIDATE)
  /// Set exactly once, when accept() succeeds — makes double-accept structurally idempotent.
  resultingMemoryId    String?               @unique
  resolvedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([userId, status, createdAt])
  @@map("memory_candidates")
}

/// A trusted, structured, user-owned memory. Every row must trace to a real
/// source (sourceType/sourceConversationId/sourceMessageId) — there is no
/// "system-generated with no attribution" path. See memory-engine.md.
model Memory {
  id                   String            @id @default(cuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 MemoryType
  title                String
  summary              String
  /// Type-specific structured detail only — never a duplicate copy of raw
  /// provider/source payloads. Schemaless by design (Sprint 3A doesn't fix a
  /// per-type shape); typed columns above cover every field queries need.
  structuredPayload    Json?
  status               MemoryStatus      @default(ACCEPTED)
  /// Snapshot of the MemoryConsentMode that actually authorized this memory
  /// at acceptance time — an audit-friendly record of "why this was allowed",
  /// independent of the user's consent settings changing later.
  consentState         MemoryConsentMode @default(ALLOW_SELECTED)
  visibility           MemoryVisibility  @default(PRIVATE)
  sourceType           MemorySourceType
  sourceConversationId String?
  sourceMessageId      String?
  /// Reserved for a future automated-expiry sweep (not implemented this
  /// sprint — no background jobs are introduced here). Purely a stored field.
  expiresAt            DateTime?
  /// Bumped on every user-visible content change; mirrors the latest MemoryVersion.version.
  version              Int               @default(1)
  /// Set by Companion context-assembly reads in a later sprint; unused (always null) in Sprint 3A.
  /// Sprint 3B's MemoryRetrievalService bumps this + referencedCount whenever a memory is
  /// actually selected by the retrieval policy — still never read into a live Companion prompt
  /// this sprint (that wiring is Sprint 3C's), but the recommendation/ranking surfaces do count
  /// as "referenced" for recency/frequency ranking purposes (see memory-intelligence.md).
  lastReferencedAt     DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  archivedAt           DateTime?
  /// Set immediately before the row itself is hard-deleted, purely so a
  /// same-transaction MemoryAudit(action: DELETED) write can carry an exact
  /// timestamp — the Memory row does not outlive its own deletedAt.
  deletedAt            DateTime?

  /// Sprint 3B — deterministic 0-100 score, recomputed by ImportanceScoringService.
  /// Never AI-derived; see memory-intelligence.md "Importance algorithm" for the documented
  /// weights. Defaults to 0 until first scored (existing Sprint 3A rows are backfilled by the
  /// migration itself, not left at a misleading 0 — see the migration SQL).
  importanceScore   Int     @default(0)
  /// Structural breakdown of which weighted inputs contributed to importanceScore (e.g.
  /// {"pinned":35,"recency":6,...}) — stored so the frontend can render "why this memory is
  /// important" without recomputing, and so the algorithm's output is auditable, not opaque.
  importanceFactors Json?
  /// Manual pin — the one importance input that is a direct user action, not inferred.
  /// Never automatically set by any scoring/detection service.
  pinned            Boolean @default(false)
  /// Bumped by MemoryRetrievalService each time this memory is actually selected into a
  /// recommendation result — used by ranking's frequency factor (Phase 7). Never bumped by a
  /// mere `list()`/`timeline()` read (those already have their own VIEWED audit action).
  referencedCount   Int     @default(0)

  versions MemoryVersion[]

  @@index([userId, status, createdAt])
  @@index([userId, type, createdAt])
  @@index([userId, createdAt])
  @@index([userId, status, importanceScore])
  @@map("memories")
}

/// One row per user-visible content change (created, updated, restored-with-
/// different-content). Full content snapshot, unlike MemoryAudit — this IS
/// memory content and is deleted along with its parent Memory (cascade).
model MemoryVersion {
  id                String           @id @default(cuid())
  memoryId          String
  memory            Memory           @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  version           Int
  type              MemoryType
  title             String
  summary           String
  structuredPayload Json?
  visibility        MemoryVisibility
  changeReason      String
  createdAt         DateTime         @default(now())

  @@unique([memoryId, version])
  @@index([memoryId, createdAt])
  @@map("memory_versions")
}

/// Event trail only — never memory content. `memoryId` is a plain indexed
/// string, deliberately NOT a foreign key: it must remain a valid historical
/// reference even after the Memory row itself has been hard-deleted (see
/// memory-privacy.md "Deletion semantics"), which an enforced FK/cascade
/// could not allow.
model MemoryAudit {
  id        String            @id @default(cuid())
  memoryId  String?
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorType MemoryActorType   @default(USER)
  action    MemoryAuditAction
  requestId String?
  /// Safe metadata only (e.g. { type, previousStatus }) — never title, summary, structuredPayload, or any other content field.
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([memoryId, createdAt])
  @@map("memory_audits")
}

// ---------------------------------------------------------------------------
// Sprint 3B — Memory Intelligence. Turns Memory Foundation's storage layer into
// a deterministic decision layer: importance scoring, duplicate detection,
// conflict detection, merge suggestions, retrieval policy, ranking, and
// context budgeting. Explicitly NOT semantic: no embeddings, no vector
// database, no RAG, no knowledge graph, no LLM-generated decisions anywhere in
// this section. See docs/architecture/memory-intelligence.md.
// ---------------------------------------------------------------------------

enum MemoryDuplicateMatchType {
  EXACT
  NORMALIZED
  STRUCTURED
  TYPE_SPECIFIC
}

enum MemoryDuplicateStatus {
  PENDING
  DISMISSED
  MERGED
}

enum MemoryConflictStatus {
  CONFLICT
  SUPERSEDED
}

enum MemoryMergeSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Pairwise duplicate finding between two of the caller's own ACCEPTED memories, computed
/// on demand by MemoryDuplicateService (no background job — see memory-intelligence.md
/// "Duplicate policy"). `similarity` is a deterministic normalized-text/structural overlap
/// score (0-100) — never an embedding distance. A duplicate is never merged by this row's
/// mere existence; see MemoryMergeSuggestion for the (also never-automatic) next step.
model MemoryDuplicate {
  id         String                   @id @default(cuid())
  userId     String
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryAId  String
  memoryBId  String
  matchType  MemoryDuplicateMatchType
  similarity Int
  status     MemoryDuplicateStatus    @default(PENDING)
  detectedAt DateTime                 @default(now())
  resolvedAt DateTime?

  @@unique([memoryAId, memoryBId])
  @@index([userId, status])
  @@map("memory_duplicates")
}

/// Pairwise conflict between two of the caller's own ACCEPTED memories — deterministic,
/// structural contradiction detection (e.g. two current-location facts that cannot both be
/// true). `NONE` is never a stored value: the absence of a row for a pair of memories *is*
/// "no conflict." `SUPERSEDED` marks the case where the newer memory is a clear replacement
/// of the older one (e.g. "I moved to Osaka" superseding "I live in Tokyo") rather than a
/// live contradiction — see memory-intelligence.md "Conflict policy". This sprint is
/// detection-only (Phase 9 exposes a read-only `GET /memory/conflicts`, no resolve mutation) —
/// there is no third "resolved" status here; a future sprint that adds explicit conflict
/// resolution should extend this model then, not speculatively now.
model MemoryConflict {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryAId  String
  memoryBId  String
  status     MemoryConflictStatus @default(CONFLICT)
  reason     String
  detectedAt DateTime             @default(now())

  @@unique([memoryAId, memoryBId])
  @@index([userId, status])
  @@map("memory_conflicts")
}

/// A suggestion — never an automatic action — to merge `duplicateMemoryId` into
/// `primaryMemoryId`, generated from a MemoryDuplicate finding. Accepting archives the
/// duplicate memory (reversible, per Sprint 3A's existing archive semantics) and keeps the
/// primary; this sprint does not synthesize new merged content (no LLM/content generation).
/// `confidence`/`reason` are both deterministic outputs of MemoryMergeSuggestionService — see
/// memory-intelligence.md "Merge policy".
model MemoryMergeSuggestion {
  id                String                      @id @default(cuid())
  userId            String
  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryMemoryId   String
  duplicateMemoryId String
  confidence        Int
  reason            String
  status            MemoryMergeSuggestionStatus @default(PENDING)
  createdAt         DateTime                    @default(now())
  resolvedAt        DateTime?

  @@unique([primaryMemoryId, duplicateMemoryId])
  @@index([userId, status])
  @@map("memory_merge_suggestions")
}

/// Observability only for the retrieval policy (Phase 5/6/9) — structural counts and
/// latency, never memory content or the memories' ids/titles/summaries themselves. See
/// memory-intelligence.md "Observability".
model MemoryRetrievalLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateCount Int
  retrievedCount Int
  tokenBudget    Int
  tokenUsed      Int
  latencyMs      Int
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("memory_retrieval_logs")
}

// ---------------------------------------------------------------------------
// Sprint 4A — Journal Foundation. A first-class, user-authored writing space:
// data model, lifecycle, versioning, search, export, draft system. Explicitly
// NOT the Reflection Engine: no AI-generated journal content, no automatic
// summarization, no mood analytics, no embeddings, no vector database, no
// semantic search, no RAG anywhere in this section. See
// docs/architecture/journal-foundation.md.
// ---------------------------------------------------------------------------

/// Deliberately a soft-delete lifecycle, unlike Memory's hard delete — see
/// docs/architecture/journal-foundation.md "Lifecycle" for why these are different features with
/// different stated requirements. DRAFT -> PUBLISHED are the only two "live authoring" states;
/// ARCHIVED and DELETED are both reversible via restore() (see JournalEntry.previousState).
enum JournalState {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

/// SHARED is stored but not functionally implemented this sprint — no recipient model, no share
/// link, no actual visibility change to any other user. Future-ready field only, per the brief's
/// own "Shared (future-ready only)" wording. Mirrors Memory's own COMPANION_ALLOWED precedent of
/// a visibility value that exists before its full mechanism does.
enum JournalVisibility {
  PRIVATE
  SHARED
}

/// Fixed, self-selected only — never inferred, scored, or trended. Mood analytics is explicitly
/// out of scope this sprint (see the mission's own non-goals list).
enum JournalMood {
  GREAT
  GOOD
  OKAY
  LOW
  DIFFICULT
}

/// How an entry came to exist. COMPANION_SUGGESTED never means Companion wrote the content — it
/// means the *draft* originated from a user-clicked "Save as Journal" suggestion button, carrying
/// over the user's own already-sent message text verbatim. See
/// docs/architecture/journal-foundation.md "Companion integration".
enum JournalSourceType {
  USER
  COMPANION_SUGGESTED
}

/// A user-owned, freeform, versioned journal entry. Ownership is enforced on every read/write —
/// see docs/security/journal-privacy.md "Ownership". Content is markdown text; rendering to HTML
/// happens client-side only (no server-side HTML generation/sanitization pipeline this sprint
/// beyond escaping when displayed as plain text).
model JournalEntry {
  id                   String            @id @default(cuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  content              String
  state                JournalState      @default(DRAFT)
  /// Set only when transitioning into ARCHIVED or DELETED — restore() always returns to exactly
  /// this state, never a guessed/default one. Null otherwise.
  previousState        JournalState?
  visibility           JournalVisibility @default(PRIVATE)
  mood                 JournalMood?
  tags                 String[]          @default([])
  /// Manual pin only — never automatically set. Surfaced in the timeline's "Pinned" section
  /// (Phase 4), same spirit as Memory.pinned.
  pinned               Boolean           @default(false)
  /// Recomputed server-side on every save from `content` — used by search result display and the
  /// editor's own count without trusting a client-supplied number.
  wordCount            Int               @default(0)
  /// Bumped only when a new JournalRevision snapshot is taken (see JournalRevision) — never on a
  /// silent autosave tick. Mirrors Memory.version's "meaningful edit" semantics.
  version              Int               @default(1)
  sourceType           JournalSourceType @default(USER)
  /// Plain string references, not enforced FKs — same reasoning as Memory's own
  /// sourceConversationId/sourceMessageId: Conversation/ConversationMessage belong to the
  /// Companion module, ownership is verified in application code at creation time, never trusted
  /// from the client, never enforced via a cross-module DB constraint.
  sourceConversationId String?
  sourceMessageId      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  publishedAt          DateTime?
  archivedAt           DateTime?
  deletedAt            DateTime?

  revisions JournalRevision[]

  @@index([userId, state, createdAt])
  @@index([userId, state, pinned, createdAt])
  @@index([userId, createdAt])
  @@map("journal_entries")
}

/// One row per meaningful edit (see journal-foundation.md "Revisions" for exactly when a
/// revision is/isn't created) — a full content snapshot, unlike an audit-style event trail.
/// Cascades with its parent JournalEntry: a revision has no meaning independent of the entry it
/// documents the history of (unlike MemoryAudit, which deliberately survives its parent's
/// deletion — Journal's soft-delete means the parent row itself never actually disappears while
/// its revisions would still be needed, so there is no equivalent "audit must outlive the row"
/// requirement here).
model JournalRevision {
  id           String       @id @default(cuid())
  journalId    String
  journal      JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  version      Int
  title        String
  content      String
  mood         JournalMood?
  tags         String[]     @default([])
  /// Plain-language reason, e.g. "published", "edited" — never a diff, never inferred.
  changeReason String
  createdAt    DateTime     @default(now())

  @@unique([journalId, version])
  @@index([journalId, createdAt])
  @@map("journal_revisions")
}

// ---------------------------------------------------------------------------
// Sprint 4B — Reflection Foundation. Deterministic Reflection Candidates built
// from existing user-owned data (Journal, Memory, Activity, Companion — see
// "Goals" note below). Explicitly NOT AI: no LLM-generated reflections, no AI
// summaries/coaching, no weekly/monthly reports, no mood/habit prediction, no
// embeddings, no pgvector, no vector database, no semantic search, no RAG, no
// knowledge graph, no autonomous agents. See docs/architecture/reflection-foundation.md.
//
// "Goals" data source: this repository has no dedicated Goal model (confirmed during this
// sprint's Phase 0 audit — see docs/progress/sprint-4b-progress.md). Memory Intelligence
// (Sprint 3B) already treats MemoryType GOAL/ACHIEVEMENT/CHALLENGE as "goal-relation" memories;
// this sprint follows that precedent rather than fabricating a new entity. A "goal" reflection
// source is always a real Memory row of one of those three types.
// ---------------------------------------------------------------------------

/// The life area a candidate is about — used for Phase 4 grouping and feed/timeline filtering.
enum ReflectionCategory {
  GOAL
  TOPIC
  JOURNAL
  WELLBEING
  ALIGNMENT
  MISMATCH
  INACTIVITY
}

/// Which deterministic rule produced this candidate — see ReflectionRuleEngine. Every value maps
/// to exactly one rule function; the candidate's `reason` is that rule's own plain-language
/// explanation of why it fired, never inferred after the fact.
enum ReflectionTrigger {
  REPEATED_TOPIC
  REPEATED_GOAL
  LONG_INACTIVITY
  GOAL_REGRESSION
  POSITIVE_STREAK
  NEGATIVE_STREAK
  REPEATED_JOURNAL_THEME
  MEMORY_JOURNAL_ALIGNMENT
  GOAL_ACTIVITY_MISMATCH
}

/// NEW/EXPIRED exist on this shared enum for forward-compatibility with the literal Sprint 4B
/// spec, mirroring MemoryStatus's own disclosed precedent (memory-engine.md) — in practice a
/// candidate is created directly as READY (rule+score computation is synchronous, so there is no
/// window where a "not yet scored" row would need to exist) and only ever moves to
/// DISMISSED/ARCHIVED (explicit user action) or EXPIRED (a cited source became invalid — see
/// "Privacy" in reflection-foundation.md). NEW is reserved, not assigned, this sprint.
enum ReflectionState {
  NEW
  READY
  DISMISSED
  ARCHIVED
  EXPIRED
}

/// The time granularity ReflectionRuleEngine scanned at when this candidate was generated —
/// distinct from the Timeline's own read-time Today/This week/Last week/Last month grouping
/// (computed live from createdAt, like Memory's timeline; see ReflectionTimelineService).
enum ReflectionWindow {
  DAY
  WEEK
  MONTH
  CUSTOM
}

/// PRIVATE: owner-only, never referenced by Companion's "you may want to reflect on this" hint.
/// COMPANION_VISIBLE (default): Companion may notice a READY candidate exists — never its content,
/// only that one exists — mirroring Memory's PRIVATE/COMPANION_ALLOWED precedent of a value that
/// gates Companion-side visibility without changing who owns or can read the row itself.
enum ReflectionVisibility {
  PRIVATE
  COMPANION_VISIBLE
}

/// Real source tables only — a "goal" source is always MEMORY (type GOAL/ACHIEVEMENT/CHALLENGE),
/// never a separate, fabricated GOAL value. See the schema-section comment above.
enum ReflectionSourceType {
  JOURNAL
  MEMORY
  ACTIVITY
  COMPANION
}

/// A deterministic Reflection Candidate — never AI-generated (see the schema-section comment
/// above). Every row must have at least one ReflectionSourceRef; ReflectionRuleEngine never
/// creates a candidate with zero real sources. `groupKey` is a plain, deterministic string (no
/// semantic clustering — see reflection-foundation.md "Grouping") used by GET /reflections/groups.
/// `dedupeKey` (trigger + groupKey + windowStart, see ReflectionGenerationService) is what makes
/// regeneration idempotent and lets a DISMISSED/ARCHIVED decision stick — the same pattern
/// MemoryDuplicateService already uses to never resurrect a resolved pair.
model ReflectionCandidate {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     ReflectionCategory
  trigger      ReflectionTrigger
  state        ReflectionState      @default(READY)
  window       ReflectionWindow
  windowStart  DateTime
  windowEnd    DateTime
  /// Plain-language, deterministically templated explanation of why this rule fired — the Product
  /// Bible's "always explain" creed, structural rather than a UI convention. Never free-text
  /// generation.
  reason       String
  /// 0-100, see ReflectionScoreService. Never AI-derived — a documented, weighted sum.
  score        Int                  @default(0)
  /// Structural breakdown of which weighted inputs contributed to `score` (frequency/recency/
  /// importance/goalRelevance/journalDensity/activity/pin) — mirrors Memory.importanceFactors so
  /// the frontend can render "why this score" without recomputing.
  scoreFactors Json?
  /// Deterministic grouping key (e.g. "GOAL:memory_<id>", "TOPIC:<token>") — see
  /// reflection-foundation.md "Grouping". Never a semantic embedding key.
  groupKey     String
  visibility   ReflectionVisibility @default(COMPANION_VISIBLE)
  /// Manual pin — the one direct user-action scoring input, never automatically set. Mirrors
  /// Memory.pinned.
  pinned       Boolean              @default(false)
  /// trigger + groupKey + windowStart fingerprint — unique per user so regeneration is an upsert,
  /// never a duplicate row, and a resolved (DISMISSED/ARCHIVED) decision is never overwritten.
  dedupeKey    String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  /// Set when the user explicitly dismisses or archives this candidate.
  resolvedAt   DateTime?
  /// Set when ReflectionValidityService finds a cited source is gone/deleted (Phase 11 privacy) —
  /// distinct from resolvedAt, which is only ever set by a real user action.
  expiredAt    DateTime?

  sources                 ReflectionSourceRef[]
  insightEvidence         InsightEvidence[]
  insightRelationshipsAsA InsightRelationship[] @relation("InsightRelationshipA")
  insightRelationshipsAsB InsightRelationship[] @relation("InsightRelationshipB")

  @@unique([userId, dedupeKey])
  @@index([userId, state, score])
  @@index([userId, state, createdAt])
  @@index([userId, groupKey])
  @@index([userId, category, state])
  @@map("reflection_candidates")
}

/// One row per real source record a ReflectionCandidate cites. "Never fabricate sources" (Phase 1)
/// is enforced structurally: every candidate is created with >= 1 of these, each pointing at a
/// real, already-existing Journal/Memory/Activity/Companion row the same user owns.
/// `sourceId`/`sourceTimestamp` are plain, unenforced references — same reasoning as Memory's own
/// `sourceConversationId`/`sourceMessageId`: the referenced tables span multiple modules, and
/// ownership/existence is checked in application code (ReflectionValidityService), never via a
/// cross-module DB constraint.
model ReflectionSourceRef {
  id                    String               @id @default(cuid())
  reflectionCandidateId String
  reflectionCandidate   ReflectionCandidate  @relation(fields: [reflectionCandidateId], references: [id], onDelete: Cascade)
  sourceType            ReflectionSourceType
  sourceId              String
  /// The source record's own real timestamp (e.g. createdAt) — never the moment this ref row was
  /// written, so recency scoring/explanations reflect the underlying evidence, not this table.
  sourceTimestamp       DateTime
  createdAt             DateTime             @default(now())

  @@index([reflectionCandidateId])
  @@index([sourceType, sourceId])
  @@map("reflection_source_refs")
}

// ---------------------------------------------------------------------------
// Sprint 4C — Insight Preparation Engine. Prepares deterministic Insight
// Candidates from existing Reflection Candidates — structured evidence for a
// future Sprint 5, never a user-facing insight itself. Explicitly NOT AI: no
// LLM-generated insights, no AI summaries/coaching, no weekly/monthly reports,
// no recommendations, no embeddings, no vector database, no semantic search,
// no RAG, no autonomous agents, no prompt optimization. See
// docs/architecture/insight-preparation.md.
//
// Layered strictly on top of Reflection Foundation (Sprint 4B): every
// InsightCandidate references real ReflectionCandidate rows via
// InsightEvidence — never Journal/Memory/Activity/Companion rows directly.
// See docs/progress/sprint-4c-progress.md "Deliberate scope decisions".
// ---------------------------------------------------------------------------

/// Isomorphic to ReflectionCategory by design — an insight's category is the dominant category
/// among the Reflection Candidates that make up its evidence, never a separately-invented
/// taxonomy. Kept as its own named enum (not a reuse of ReflectionCategory) because Phase 1 of
/// this sprint names InsightCategory as its own domain concept.
enum InsightCategory {
  GOAL
  TOPIC
  JOURNAL
  WELLBEING
  ALIGNMENT
  MISMATCH
  INACTIVITY
}

/// Exactly the four states this sprint's own brief specifies — no fifth "EXPIRED" state was
/// added; source invalidation (Phase 8) is handled by recomputing readiness from only the
/// still-valid evidence on every read, which naturally falls back to NOT_READY/
/// INSUFFICIENT_EVIDENCE rather than needing a separate stored state. See
/// InsightValidityService.
enum InsightStatus {
  NOT_READY
  READY
  INSUFFICIENT_EVIDENCE
  ARCHIVED
}

/// The time granularity the evidence spans — same four values as ReflectionWindow, same
/// reasoning (see reflection-foundation.md).
enum InsightWindow {
  DAY
  WEEK
  MONTH
  CUSTOM
}

/// The seven relationship types this sprint's own brief specifies. See
/// insight-preparation.md "Relationship Engine" for the exact, fixed classification rules —
/// structural comparison of two ReflectionCandidates' category/trigger/groupKey/score/window
/// only, never semantic similarity.
enum InsightRelationshipType {
  SUPPORTS
  CONTRADICTS
  CONTINUES
  REPEATS
  IMPROVES
  REGRESSES
  STAGNATES
}

/// A deterministic Insight Candidate — structured evidence prepared for a future Sprint 5, never
/// a user-facing insight itself (no generated text beyond a plain, templated rule explanation).
/// Every row must have >= 1 InsightEvidence; InsightGenerationService never creates a candidate
/// with zero real evidence. `dedupeKey` (category + the cluster's anchor ReflectionCandidate id —
/// see InsightGenerationService) makes regeneration idempotent and lets an ARCHIVED decision
/// stick, the same pattern ReflectionCandidate.dedupeKey already uses.
model InsightCandidate {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        InsightCategory
  status          InsightStatus   @default(NOT_READY)
  window          InsightWindow
  windowStart     DateTime
  windowEnd       DateTime
  /// Plain-language, deterministically templated explanation of which relationships/rules formed
  /// this cluster (e.g. "3 reflections connected by REPEATS and CONTINUES over 21 days") — never
  /// free-text generation. Mirrors ReflectionCandidate.reason.
  ruleExplanation String
  /// 0-100, see InsightPriorityService. Never AI-derived — a documented, weighted sum.
  priority        Int             @default(0)
  /// Structural breakdown of which weighted inputs contributed to `priority` (frequency/
  /// consistency/reflectionScore/goalRelevance/activity/journalDensity/memoryImportance) — mirrors
  /// ReflectionCandidate.scoreFactors so confidence explanations never drift from the actual
  /// computation.
  priorityFactors Json?
  /// category + anchor ReflectionCandidate id — see InsightGenerationService "Clustering".
  dedupeKey       String
  /// Manual pin — Sprint 5A (Insight Experience) presentation-layer user action, mirrors
  /// ReflectionCandidate.pinned/Memory.pinned. Never set automatically; purely a display flag —
  /// changes no category/priority/evidence and is untouched by regeneration.
  pinned          Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  /// Set only when the user explicitly archives this candidate via POST .../archive.
  resolvedAt      DateTime?

  evidence      InsightEvidence[]
  relationships InsightRelationship[]

  @@unique([userId, dedupeKey])
  @@index([userId, status, priority])
  @@index([userId, category, status])
  @@index([userId, pinned])
  @@map("insight_candidates")
}

/// One row per real ReflectionCandidate an InsightCandidate cites as evidence. "Never fabricate
/// evidence" (Phase 3) is enforced structurally: every row is only ever created from a
/// ReflectionCandidate id already present in a fetched, userId-scoped snapshot
/// (InsightDataSourceService) — there is no code path that could cite an id it wasn't handed.
/// A real FK (not a plain string reference like ReflectionSourceRef's cross-module sourceId) is
/// used here because InsightCandidate and ReflectionCandidate are siblings in the same schema,
/// not crossing a module boundary the way Reflection's own Journal/Memory/Activity/Companion
/// references do.
model InsightEvidence {
  id                    String              @id @default(cuid())
  insightCandidateId    String
  insightCandidate      InsightCandidate    @relation(fields: [insightCandidateId], references: [id], onDelete: Cascade)
  reflectionCandidateId String
  reflectionCandidate   ReflectionCandidate @relation(fields: [reflectionCandidateId], references: [id], onDelete: Cascade)
  /// Plain-language, deterministically templated: what this specific reflection contributes to
  /// the cluster (e.g. "Repeated topic, score 60, observed 8/5/2026").
  contribution          String
  createdAt             DateTime            @default(now())

  @@unique([insightCandidateId, reflectionCandidateId])
  @@index([insightCandidateId])
  @@index([reflectionCandidateId])
  @@map("insight_evidence")
}

/// A deterministic, pairwise relationship between two of the caller's own ReflectionCandidates —
/// computed by InsightRelationshipEngine (Phase 2), never semantic similarity. `insightCandidateId`
/// is set once the pair's cluster becomes an InsightCandidate (SetNull if that candidate is later
/// removed — the edge itself remains a real, independently-computed fact). `reflectionAId`/
/// `reflectionBId` are canonically ordered (A.id < B.id, see orderPair()) so the unique constraint
/// can't be bypassed by swapping the pair.
model InsightRelationship {
  id                 String                  @id @default(cuid())
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  insightCandidateId String?
  insightCandidate   InsightCandidate?       @relation(fields: [insightCandidateId], references: [id], onDelete: SetNull)
  reflectionAId      String
  reflectionA        ReflectionCandidate     @relation("InsightRelationshipA", fields: [reflectionAId], references: [id], onDelete: Cascade)
  reflectionBId      String
  reflectionB        ReflectionCandidate     @relation("InsightRelationshipB", fields: [reflectionBId], references: [id], onDelete: Cascade)
  type               InsightRelationshipType
  /// Plain-language, deterministically templated explanation of why this relationship was
  /// classified this way (e.g. "Same goal, score rose from 40 to 62").
  reason             String
  detectedAt         DateTime                @default(now())

  @@unique([reflectionAId, reflectionBId])
  @@index([userId])
  @@index([insightCandidateId])
  @@map("insight_relationships")
}

// ---------------------------------------------------------------------------
// Sprint 5B — Weekly & Monthly Reviews. Deterministically aggregates existing
// InsightCandidate/ReflectionCandidate rows (plus real Journal/Memory/Activity/
// Companion counts for statistics) over a time window into a persisted Review
// document. Generates NO new InsightCandidate/ReflectionCandidate rows —
// strictly a read/aggregate layer, the same "never re-derive a lower layer's
// own job" discipline every prior sprint in this schema follows. Explicitly
// NOT AI: no LLM, no coaching, no recommendations, no embeddings, no vector
// database, no semantic search, no autonomous agents, no conversational
// reports. See docs/architecture/review-engine.md.
// ---------------------------------------------------------------------------

/// Compute-on-read window granularity — mirrors ReflectionWindow/InsightWindow's own three/four-
/// value shape and reasoning.
enum ReviewWindow {
  WEEK
  MONTH
  CUSTOM
}

/// Exactly three states: a review with no qualifying evidence in its window, a real generated
/// review, and an explicit user archive — no fifth invented state, same reasoning as
/// InsightStatus's own "no EXPIRED" precedent (a Review is regenerated fresh on every read up
/// until archived, so there's nothing that needs a separate "went stale" state).
enum ReviewState {
  NOT_READY
  READY
  ARCHIVED
}

/// Fixed section taxonomy this sprint's own brief specifies — Overview is a top-level Review
/// field (see `overview` below), not its own section row.
enum ReviewSectionType {
  HIGHLIGHTS
  CHANGES
  ACHIEVEMENTS
  CHALLENGES
}

/// Real source tables only, exactly the five this sprint's mission specifies it must consume.
/// ACTIVITY/COMPANION are cited only via a ReflectionCandidate's own sources (Reviews never read
/// ActivityEvent/ConversationMessage rows directly for evidence — only for Phase 3 statistics
/// counts, which is a different, aggregate-only read path — see ReviewStatisticsService).
enum ReviewEvidenceSourceType {
  INSIGHT
  REFLECTION
  JOURNAL
  MEMORY
}

/// One review document for one user, one window. `dedupeKey` (`window:windowStart:windowEnd`) is
/// unique per user — the same idempotent-regeneration pattern ReflectionCandidate/InsightCandidate
/// already use, so `ensureGenerated()` upserts in place rather than duplicating a row for the same
/// period. `statistics` is an embedded JSON aggregate (Phase 3) — mirrors
/// InsightCandidate.priorityFactors/ReflectionCandidate.scoreFactors's own "embedded, not a
/// separate table" precedent, since a review's statistics are 1:1 with the review itself.
model Review {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  window      ReviewWindow
  windowStart DateTime
  windowEnd   DateTime
  state       ReviewState  @default(NOT_READY)
  /// Plain-language, deterministically templated top-level summary (Phase 2 "Overview") — counts
  /// and section totals only, never free-text generation. See review-builder.ts buildOverview().
  overview    String
  /// ReviewStatistics shape (Phase 3) — journal/memory/reflection/insight counts, journaling
  /// streak, companion conversation count. See review.types.ts.
  statistics  Json
  dedupeKey   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  /// Set only when the user explicitly archives this review via POST .../archive.
  resolvedAt  DateTime?

  sections ReviewSection[]

  @@unique([userId, dedupeKey])
  @@index([userId, window, windowStart])
  @@index([userId, state])
  @@map("reviews")
}

/// One row per non-empty section (Highlights/Changes/Achievements/Challenges) — a section with no
/// qualifying evidence is simply not created, never a fabricated empty placeholder with invented
/// text. `summary` is a deterministic template over the section's own evidence count/average
/// priority, mirroring InsightCandidate.ruleExplanation's own "describe what's really there" rule.
model ReviewSection {
  id        String            @id @default(cuid())
  reviewId  String
  review    Review            @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  type      ReviewSectionType
  title     String
  summary   String
  order     Int
  createdAt DateTime          @default(now())

  evidence ReviewEvidence[]

  @@unique([reviewId, type])
  @@index([reviewId])
  @@map("review_sections")
}

/// One row per real Insight/Reflection/Journal/Memory record a section cites. "Never fabricate
/// evidence" is enforced the same structural way Insight Preparation enforces it: a row is only
/// ever created from an id already present in a fetched, userId-scoped snapshot
/// (ReviewGenerationService). `sourceId` is a plain, unenforced cross-module reference — same
/// reasoning as ReflectionSourceRef's own sourceId (the referenced tables span multiple modules).
model ReviewEvidence {
  id              String                   @id @default(cuid())
  reviewSectionId String
  reviewSection   ReviewSection            @relation(fields: [reviewSectionId], references: [id], onDelete: Cascade)
  sourceType      ReviewEvidenceSourceType
  sourceId        String
  /// The item's own real InsightCategory/ReflectionCategory string (or a real-precedent-derived
  /// one for MEMORY/JOURNAL items — see review-generation.service.ts) — persisted (not only
  /// embedded in `contribution`'s text) so Phase 6's category filter is a real, indexed query,
  /// never a text-parse.
  category        String
  /// The item's own real priority/score/importance (0-100) — same reasoning as `category` above,
  /// persisted so Phase 6's priority-tier filter doesn't need to re-parse `contribution`.
  priority        Int
  /// The source record's own real timestamp — never the moment this row was written.
  sourceTimestamp DateTime
  /// Plain-language, deterministically templated: what this specific item contributes to the
  /// section (e.g. "Insight: 3 reflections connected by SUPPORTS relationships — High priority.").
  contribution    String
  createdAt       DateTime                 @default(now())

  @@index([reviewSectionId])
  @@index([sourceType, sourceId])
  @@index([reviewSectionId, category])
  @@index([reviewSectionId, priority])
  @@map("review_evidence")
}

// ---------------------------------------------------------------------------
// Sprint 5C — Goal System & Progress Engine. First-class, deterministic
// learning/life goals: CRUD, milestones, a deterministic progress engine, and
// real evidence citing Memory/Journal/Reflection/Insight/Review/Activity rows.
// Explicitly NOT AI: no LLM, no coaching, no recommendations, no embeddings,
// no vector database, no semantic search, no RAG, no autonomous agents, no
// predictive analytics. `Memory.type: GOAL/ACHIEVEMENT/CHALLENGE`,
// `ReflectionCategory.GOAL`, and `InsightCategory.GOAL` are untouched by this
// sprint — a Goal cites them as evidence, it does not replace or rewrite them.
// See docs/architecture/goal-system.md.
// ---------------------------------------------------------------------------

enum GoalCategory {
  LEARNING
  CAREER
  HEALTH
  HABIT
  RELATIONSHIP
  FINANCIAL
  CREATIVE
  PERSONAL
  OTHER
}

/// Determines GoalProgressEngine's one fixed, documented completion formula for this goal — see
/// goal-system.md "Progress formulas". Never a weighted/inferred model.
enum GoalType {
  MILESTONE_BASED
  METRIC_BASED
  BINARY
}

/// User-selected only — never computed, never affects scoring.
enum GoalDifficulty {
  EASY
  MEDIUM
  HARD
}

/// Every transition is an explicit user action (pause/resume/archive/delete/complete/abandon) —
/// see goal-system.md "Status transitions are always explicit". COMPLETED is never set
/// automatically by the progress engine, even at 100%.
enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
  ARCHIVED
  DELETED
}

/// Mirrors ReflectionVisibility/Memory's PRIVATE/COMPANION_ALLOWED precedent exactly — gates
/// whether Companion's context assembly may reference this goal's title, never a public/community
/// visibility.
enum GoalVisibility {
  PRIVATE
  COMPANION_VISIBLE
}

/// AUTOMATIC completes deterministically once the goal's real evidence count reaches
/// GoalMilestone.targetCount (recomputed by GoalProgressEngine). MANUAL is only ever
/// completed/failed by an explicit user action.
enum GoalMilestoneType {
  AUTOMATIC
  MANUAL
}

enum GoalMilestoneStatus {
  PENDING
  COMPLETED
  FAILED
  ARCHIVED
}

/// Derived by comparing GoalProgress.completionPercent against its own previousCompletionPercent
/// — never a forecast, never predictive. NEW means no prior computation exists yet.
enum GoalTrend {
  NEW
  IMPROVING
  STABLE
  DECLINING
}

/// Real source tables only — see goal-system.md "Evidence linking" for the exact, deterministic
/// tag/category-equality rule per source type. ACTIVITY exists on this enum per the brief's own
/// explicit list, but no automatic GoalEvidence row is ever created from it this sprint (no
/// goal-specific ActivityType exists in this product — disclosed, not fabricated).
enum GoalEvidenceSourceType {
  JOURNAL
  MEMORY
  REFLECTION
  INSIGHT
  REVIEW
  ACTIVITY
}

/// Append-only lifecycle event log — mirrors MemoryAudit's own action-list precedent. Content-free
/// beyond a plain, templated `detail` sentence (never journal/memory/reflection text).
enum GoalHistoryAction {
  CREATED
  UPDATED
  PAUSED
  RESUMED
  COMPLETED
  ABANDONED
  ARCHIVED
  RESTORED
  DELETED
  MILESTONE_COMPLETED
  MILESTONE_FAILED
}

/// PARENT_CHILD is directional (goalA is the parent); RELATED is symmetric. Both are explicit,
/// user-created links — no automatic relationship detection (would require semantic comparison
/// between goals, out of scope this sprint).
enum GoalRelationshipType {
  PARENT_CHILD
  RELATED
}

/// A user-authored, first-class learning/life goal. Ownership is enforced on every read/write —
/// see docs/security/goal-privacy.md "Ownership". `linkedTag` is the one real, deterministic
/// matching key GoalProgressEngine uses to gather evidence — never semantic/AI matching.
model Goal {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       GoalCategory
  type           GoalType
  difficulty     GoalDifficulty @default(MEDIUM)
  status         GoalStatus     @default(ACTIVE)
  /// Set only when transitioning into ARCHIVED or DELETED — restore() always returns to exactly
  /// this state, never a guessed/default one. Mirrors JournalEntry.previousState.
  previousStatus GoalStatus?
  visibility     GoalVisibility @default(PRIVATE)
  /// The real, deterministic tag GoalProgressEngine matches JournalEntry.tags / Memory title-
  /// summary substrings / ReflectionCandidate.groupKey against — see goal-system.md.
  linkedTag      String
  /// METRIC_BASED only — the real countable target (e.g. 12 for "read 12 books").
  targetValue    Int?
  /// METRIC_BASED only — a plain label for targetValue's unit (e.g. "books", "sessions"). Never
  /// parsed/interpreted, display-only.
  targetUnit     String?
  targetDate     DateTime?
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?
  deletedAt      DateTime?

  milestones       GoalMilestone[]
  progress         GoalProgress?
  history          GoalHistory[]
  relationshipsAsA GoalRelationship[] @relation("GoalRelationshipA")
  relationshipsAsB GoalRelationship[] @relation("GoalRelationshipB")

  @@index([userId, status, createdAt])
  @@index([userId, category, status])
  @@index([userId, linkedTag])
  @@map("goals")
}

/// A checkpoint within a Goal. AUTOMATIC milestones are recomputed by GoalProgressEngine every
/// time it runs; MANUAL milestones only change via an explicit user action.
model GoalMilestone {
  id          String              @id @default(cuid())
  goalId      String
  goal        Goal                @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  description String
  type        GoalMilestoneType
  status      GoalMilestoneStatus @default(PENDING)
  order       Int
  /// AUTOMATIC only — the goal's real evidence count this milestone completes at.
  targetCount Int?
  dueDate     DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([goalId, order])
  @@index([goalId, status])
  @@map("goal_milestones")
}

/// The current, recomputed-in-place progress snapshot for one Goal — mirrors
/// Memory.importanceScore/importanceFactors's own "recompute and overwrite, never append"
/// precedent (Sprint 3B), not the window-keyed append pattern Review/InsightCandidate use (a Goal
/// has no natural time window). previousCompletionPercent/previousComputedAt are captured just
/// before being overwritten — what makes GoalTrend derivable without a second history table.
model GoalProgress {
  id                         String    @id @default(cuid())
  goalId                     String    @unique
  goal                       Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  completionPercent          Int       @default(0)
  milestoneCompletionPercent Int       @default(0)
  /// Structural breakdown of how completionPercent was computed (evidence counts by source,
  /// milestone counts, metric currentValue/targetValue) — mirrors scoreFactors/priorityFactors/
  /// importanceFactors precedent so the frontend never needs to recompute to explain a number.
  factors                    Json?
  trend                      GoalTrend @default(NEW)
  previousCompletionPercent  Int?
  previousComputedAt         DateTime?
  computedAt                 DateTime  @default(now())

  evidence GoalEvidence[]

  @@map("goal_progress")
}

/// One row per real Memory/Journal/Reflection/Insight/Review record cited by the current
/// GoalProgress computation. Recreated fresh on every recompute — the same "delete + recreate"
/// discipline ReviewGenerationService/InsightGenerationService already use for their own evidence
/// tables. `sourceId` is a plain, unenforced cross-module reference, same reasoning as
/// ReflectionSourceRef/ReviewEvidence's own sourceId.
model GoalEvidence {
  id              String                 @id @default(cuid())
  goalProgressId  String
  goalProgress    GoalProgress           @relation(fields: [goalProgressId], references: [id], onDelete: Cascade)
  sourceType      GoalEvidenceSourceType
  sourceId        String
  /// The source record's own real timestamp — never the moment this row was written.
  sourceTimestamp DateTime
  /// Plain-language, deterministically templated: what this specific item contributes (e.g.
  /// "Journal entry tagged 'spanish', published 8/5/2026.").
  contribution    String
  createdAt       DateTime               @default(now())

  @@index([goalProgressId])
  @@index([sourceType, sourceId])
  @@map("goal_evidence")
}

/// Append-only lifecycle event log — mirrors MemoryAudit's own precedent (event trail only, never
/// re-derivable content). Survives regardless of the Goal's current status.
model GoalHistory {
  id        String            @id @default(cuid())
  goalId    String
  goal      Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  action    GoalHistoryAction
  /// Plain-language, deterministically templated — never free-text generation.
  detail    String
  createdAt DateTime          @default(now())

  @@index([goalId, createdAt])
  @@map("goal_history")
}

/// A real, explicit, user-created link between two of the caller's own Goals. No automatic
/// relationship detection — see goal-system.md "Known limitations".
model GoalRelationship {
  id        String               @id @default(cuid())
  goalAId   String
  goalA     Goal                 @relation("GoalRelationshipA", fields: [goalAId], references: [id], onDelete: Cascade)
  goalBId   String
  goalB     Goal                 @relation("GoalRelationshipB", fields: [goalBId], references: [id], onDelete: Cascade)
  type      GoalRelationshipType
  createdAt DateTime             @default(now())

  @@unique([goalAId, goalBId, type])
  @@index([goalAId])
  @@index([goalBId])
  @@map("goal_relationships")
}

// ---------------------------------------------------------------------------
// Sprint 6 — Tarot Discovery Foundation. The first real Discovery system
// (Product Bible Module 12) — a deterministic, seeded 78-card draw engine
// with real traditional card meanings, plus a narrow AI interpretation layer
// that only ever narrates a real, already-drawn result (see
// docs/architecture/tarot-discovery.md). Explicitly NOT AI-generated cards,
// NOT AI-chosen cards, NOT Natal Chart/Eastern Horoscope/Numerology/Premium —
// those remain out of scope per docs/audit/web-tu-vi-remediation-roadmap.md.
// Reflection/Insight/Review/Goal above are frozen, untouched by this sprint.
// ---------------------------------------------------------------------------

enum TarotArcana {
  MAJOR
  MINOR
}

enum TarotSuit {
  WANDS
  CUPS
  SWORDS
  PENTACLES
}

/// DAILY_DRAW and SINGLE_CARD both draw exactly one card via the identical engine — they differ
/// only in rate limiting and framing (see tarot-discovery.md "Reading types"). DAILY_DRAW is
/// rate-limited to once per UTC calendar day per user (Module 12: "no re-draw allowed... to
/// preserve the reflective premise"); SINGLE_CARD and THREE_CARD are unlimited, on-demand.
enum TarotReadingType {
  DAILY_DRAW
  SINGLE_CARD
  THREE_CARD
}

/// Mirrors JournalEntry/Goal's own reversible-archive + soft-delete precedent exactly.
enum TarotReadingStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

/// Mirrors Memory/Reflection/Goal's own PRIVATE/COMPANION_VISIBLE precedent exactly — gates
/// whether Companion's context assembly may reference this reading, never a public visibility.
enum TarotReadingVisibility {
  PRIVATE
  COMPANION_VISIBLE
}

/// Append-only lifecycle event log — mirrors GoalHistory/MemoryAudit's own precedent.
enum TarotReadingHistoryAction {
  CREATED
  VIEWED
  INTERPRETED
  ARCHIVED
  RESTORED
  DELETED
}

/// The full, real, 78-card traditional Tarot deck — no placeholders, no AI-generated content.
/// Upright/reversed meanings and keywords are original text grounded in traditional/public-domain
/// Tarot knowledge (see docs/progress/sprint-6-progress.md "Deliberate scope decisions" #3).
/// `imageSlug` is a stable reference for a future art asset pipeline — no illustration exists yet
/// (disclosed, not faked; the frontend renders a typographic/symbolic card face instead).
model TarotCard {
  id               String      @id @default(cuid())
  /// URL-safe, stable, human-readable (e.g. "major-00-the-fool", "wands-05-five-of-wands").
  slug             String      @unique
  name             String
  arcana           TarotArcana
  /// Null for Major Arcana.
  suit             TarotSuit?
  /// Major Arcana: 0-21 (The Fool through The World). Minor Arcana: 1-14 (Ace, 2-10, Page=11,
  /// Knight=12, Queen=13, King=14).
  number           Int
  uprightKeywords  String[]
  uprightMeaning   String
  reversedKeywords String[]
  reversedMeaning  String
  /// Real, traditional elemental correspondence (Fire/Water/Air/Earth) — null only where the
  /// traditional system genuinely assigns none.
  element          String?
  /// Real, traditional planet/zodiac correspondence, where the traditional system assigns one.
  astrological     String?
  /// Real thematic tags (e.g. "love", "career", "change") for Phase 5's search/filter — derived
  /// from the card's own actual meaning, never arbitrary.
  categories       String[]
  imageSlug        String
  createdAt        DateTime    @default(now())

  readingCards TarotReadingCard[]

  @@index([arcana])
  @@index([suit])
  @@map("tarot_cards")
}

/// A named spread template (position count + labels) — referenced by every TarotReading, not
/// duplicated per-reading. Seeded once alongside the deck: "daily-draw" (1 position, "Today"),
/// "single-card" (1 position, "Focus"), "three-card-ppf" (3 positions, Past/Present/Future).
model TarotSpread {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  cardCount Int
  /// [{ order: 0, label: "Past" }, ...] — real, fixed, never generated per-reading.
  positions Json
  createdAt DateTime @default(now())

  readings TarotReading[]

  @@map("tarot_spreads")
}

/// A persisted Tarot reading. `interpretation` is null until the AI narration step completes
/// (Phase 4) — a reading is fully real and viewable (real cards, real meanings) before that, the
/// interpretation is additive, never a precondition for the deterministic result to exist.
model TarotReading {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           TarotReadingType
  spreadId       String
  spread         TarotSpread            @relation(fields: [spreadId], references: [id])
  status         TarotReadingStatus     @default(ACTIVE)
  visibility     TarotReadingVisibility @default(PRIVATE)
  /// Optional — Daily Draw never requires one; Single Card/Three Card may carry the user's own
  /// real question, never fabricated.
  question       String?
  /// AI-narrated interpretation of the real drawn cards (Phase 4) — null until generated, never a
  /// placeholder string in the meantime.
  interpretation String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  archivedAt     DateTime?
  deletedAt      DateTime?

  cards   TarotReadingCard[]
  session TarotReadingSession?
  history TarotReadingHistory[]

  @@index([userId, status, createdAt])
  @@index([userId, type, createdAt])
  @@map("tarot_readings")
}

/// One row per real card drawn within a reading — "never fabricate a card" is enforced
/// structurally: every row's `cardId` is a real FK into the fixed 78-row `TarotCard` table, and
/// `isReversed` is set once, at draw time, by the deterministic engine (Phase 2) — never changed
/// after the fact.
model TarotReadingCard {
  id            String       @id @default(cuid())
  readingId     String
  reading       TarotReading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  cardId        String
  card          TarotCard    @relation(fields: [cardId], references: [id])
  /// 0-indexed position within the spread.
  position      Int
  /// Copied from the spread's own position label at draw time (e.g. "Past") — denormalized so a
  /// reading's own history reads correctly even if the spread template's labels are ever revised.
  positionLabel String?
  isReversed    Boolean      @default(false)

  @@unique([readingId, position])
  @@index([readingId])
  @@index([cardId])
  @@map("tarot_reading_cards")
}

/// The deterministic-draw audit record — one row per TarotReading, storing exactly what the
/// engine needs to reproduce the same draw again: the seed, the algorithm version, and the full
/// shuffled deck order it drew from. This is what makes Phase 2's "engine must be reproducible"
/// requirement independently verifiable after the fact, not just true at draw-time (see
/// tarot-discovery.md "Draw engine").
model TarotReadingSession {
  id              String       @id @default(cuid())
  readingId       String       @unique
  reading         TarotReading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  seed            String
  algorithm       String
  /// The full 78-card shuffled order (card ids) the draw was taken from the front of.
  shuffledCardIds Json
  createdAt       DateTime     @default(now())

  @@map("tarot_reading_sessions")
}

/// Append-only lifecycle event log — mirrors GoalHistory's own precedent exactly.
model TarotReadingHistory {
  id        String                    @id @default(cuid())
  readingId String
  reading   TarotReading              @relation(fields: [readingId], references: [id], onDelete: Cascade)
  action    TarotReadingHistoryAction
  detail    String
  createdAt DateTime                  @default(now())

  @@index([readingId, createdAt])
  @@map("tarot_reading_history")
}

// ---------------------------------------------------------------------------
// Sprint 7 — Premium & Payment Foundation (Product Bible Module 17, narrowed).
// One paid product (`PREMIUM_30D`), one provider (PayOS), one entitlement domain.
// Premium is a real, backend-owned row here — never a bare `user.isPremium` flag —
// and is granted exclusively by `PaymentWebhookService` after independently verifying
// a PayOS webhook signature, never by a frontend redirect/query param/client callback.
// See docs/architecture/premium-entitlements.md and docs/architecture/payment-foundation.md.
// ---------------------------------------------------------------------------

/// Exactly one provider implemented this sprint (see payment-foundation.md "Provider decision") —
/// the enum still exists (rather than a bare string) so a second provider is a data value, not a
/// schema migration, when Sprint 8+ decides to add one.
enum PaymentProviderCode {
  PAYOS
}

/// Exactly one paid product this sprint — a 30-day, time-boxed Premium pass, not an auto-renewing
/// subscription (PayOS's hosted checkout is a one-time payment link; a recurring billing engine is
/// not required for that flow). Repeat purchases stack `expiresAt` forward — see EntitlementService.
enum PaymentProductCode {
  PREMIUM_30D
}

/// PENDING is the only client-reachable initial state. PAID/FAILED/EXPIRED/CANCELLED are terminal —
/// once PAID, an order must never transition again (a late/duplicate/stale webhook must never revert
/// it). See payment-foundation.md "State machine" for the full allowed-transition table.
enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

/// Lifecycle of one inbound webhook delivery, independent of the PaymentOrder it (may) reference —
/// kept even for rejected/unrecognized deliveries so a forged or malformed webhook is still audited.
enum PaymentWebhookStatus {
  RECEIVED
  VERIFIED
  REJECTED
  PROCESSED
  ERROR
}

/// ACTIVE/REVOKED are the only states this sprint's code ever writes (REVOKED is reserved for a
/// future manual/refund action — no admin UI exists yet, out of Sprint 7 scope). EXPIRED is never
/// persisted: `EntitlementService.hasPremiumAccess` computes expiry from `expiresAt` at read time
/// rather than relying on a background job to flip the stored status — see premium-entitlements.md.
enum PremiumEntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/// Single source this sprint — a verified PayOS payment. Kept as an enum (not inlined onto
/// PaymentOrder) so a future non-payment grant path (promo, admin, referral — none in scope now)
/// is a new enum value, not a new column.
enum PremiumEntitlementSource {
  PAYMENT
}

/// One row per checkout attempt. `providerOrderCode` is generated by us (see PaymentCheckoutService)
/// and echoed back by PayOS on both the create-payment-link response and every webhook delivery —
/// it is what correlates an inbound webhook to this order; `providerPaymentLinkId` is PayOS's own
/// identifier for the hosted checkout session. Price/currency are set exclusively by the backend at
/// creation time (`PREMIUM_PRICE_VND` config) — the client never supplies or influences them.
model PaymentOrder {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product               PaymentProductCode  @default(PREMIUM_30D)
  amount                Int
  currency              String              @default("VND")
  provider              PaymentProviderCode
  /// Our own generated reference, unique per order — what PayOS's `orderCode` echoes back.
  providerOrderCode     String              @unique
  providerPaymentLinkId String?
  providerCheckoutUrl   String?
  status                PaymentOrderStatus  @default(PENDING)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  paidAt                DateTime?
  failedAt              DateTime?
  /// Checkout links are short-lived; used to identify stale PENDING orders, never enforced by a
  /// background sweep this sprint (see payment-foundation.md "Known limitations").
  expiresAt             DateTime?
  /// Safe, non-sensitive audit context only (e.g. description shown at checkout) — never card
  /// numbers, CVV, banking credentials, or provider secrets.
  metadata              Json?

  webhookEvents PaymentWebhookEvent[]
  entitlement   PremiumEntitlement?

  @@index([userId, status])
  @@index([provider, providerOrderCode])
  @@map("payment_orders")
}

/// One row per inbound webhook delivery — the idempotency ledger. `externalEventId` is derived from
/// PayOS's own `orderCode` + bank `reference` (the closest thing PayOS gives to a global event id);
/// the `@@unique([provider, externalEventId])` constraint is what makes a duplicate/replayed delivery
/// safe even under concurrent requests (a second insert of the same pair fails at the DB level before
/// any entitlement logic runs). `payloadHash` is a sha256 of the raw payload for audit purposes —
/// never the raw payload itself, and never a sensitive banking field.
model PaymentWebhookEvent {
  id              String               @id @default(cuid())
  provider        PaymentProviderCode
  externalEventId String
  orderId         String?
  order           PaymentOrder?        @relation(fields: [orderId], references: [id])
  payloadHash     String
  status          PaymentWebhookStatus @default(RECEIVED)
  /// e.g. INVALID_SIGNATURE, UNKNOWN_ORDER, AMOUNT_MISMATCH, CURRENCY_MISMATCH, DUPLICATE — set
  /// only on REJECTED/ERROR, never a raw exception message or payload fragment.
  errorCategory   String?
  receivedAt      DateTime             @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
  @@index([orderId])
  @@map("payment_webhook_events")
}

/// A granted Premium window. One row per successful payment (repeat purchases stack: a new row's
/// `startsAt` continues from the user's current furthest `expiresAt` rather than resetting to "now"
/// — see EntitlementService.grantPremium). `hasPremiumAccess` is the only path the rest of the app
/// may use to decide Premium access; never a scattered `user.isPremium`-style check.
model PremiumEntitlement {
  id        String                   @id @default(cuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    PremiumEntitlementStatus @default(ACTIVE)
  source    PremiumEntitlementSource @default(PAYMENT)
  startsAt  DateTime                 @default(now())
  /// Null would mean lifetime access — never set that way by `grantPremium` this sprint (every grant
  /// is a 30-day window), but left nullable for a future non-expiring grant path.
  expiresAt DateTime?
  grantedAt DateTime                 @default(now())
  revokedAt DateTime?
  orderId   String                   @unique
  order     PaymentOrder             @relation(fields: [orderId], references: [id])
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([userId, status])
  @@index([userId, expiresAt])
  @@map("premium_entitlements")
}

// ---------------------------------------------------------------------------
// Sprint 8 — Numerology Discovery Foundation (Product Bible Module 15). The second
// real Discovery system: a deterministic, versioned, standard-Pythagorean numerology
// engine (see apps/api/src/numerology/engine/) with a narrow AI interpretation layer
// that only ever narrates already-real, already-computed core numbers. Explicitly NOT
// AI-generated numbers, NOT Natal Chart/Eastern Horoscope, NOT a second payment
// provider — those remain out of scope per docs/audit/web-tu-vi-remediation-roadmap.md.
// Reflection/Insight/Review/Goal remain frozen, untouched by this sprint.
// ---------------------------------------------------------------------------

/// Mirrors TarotReadingStatus/JournalEntry/Goal's own reversible-archive + soft-delete
/// precedent exactly.
enum NumerologyReadingStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

/// Mirrors TarotReadingVisibility/Memory/Reflection/Goal's own PRIVATE/COMPANION_VISIBLE
/// precedent exactly — gates whether Companion's context assembly may reference this
/// reading, never a public visibility.
enum NumerologyReadingVisibility {
  PRIVATE
  COMPANION_VISIBLE
}

/// Append-only lifecycle event log — mirrors TarotReadingHistory/GoalHistory's own
/// precedent exactly.
enum NumerologyReadingHistoryAction {
  CREATED
  VIEWED
  INTERPRETED
  ARCHIVED
  RESTORED
  DELETED
}

/// The six core numbers this sprint implements (Product Bible Module 15 §4/§18) — Life
/// Path, Expression, Soul Urge, Personality, and Birthday are permanent/high-durability;
/// Personal Year is time-bound and calculated for a specific calendar year
/// (`NumerologyValue.appliesToYear`). Personal Month is explicitly deferred (§22) — not
/// implemented this sprint.
enum NumerologyValueType {
  LIFE_PATH
  EXPRESSION
  SOUL_URGE
  PERSONALITY
  BIRTHDAY
  PERSONAL_YEAR
}

/// A persisted Numerology reading — one calculation of the six core numbers from a real,
/// user-submitted `birthNameInput`/`birthDate`, computed once by the deterministic engine
/// and never recalculated after the fact. `birthNameInput` is what the user actually typed
/// (shown back to them so normalization is never silent, per the sprint brief's Phase 2
/// transparency requirement); `normalizedBirthName` is the exact upper-cased,
/// diacritic-stripped string the engine calculated from
/// (`numerology-name.util.ts#normalizeName`). `calculationVersion`/`normalizationVersion`
/// pin the exact engine/normalization revision used, so a future rule change never
/// silently reinterprets an old reading (Phase 7: reproducibility/versioning).
model NumerologyReading {
  id                   String                      @id @default(cuid())
  userId               String
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               NumerologyReadingStatus     @default(ACTIVE)
  visibility           NumerologyReadingVisibility @default(PRIVATE)
  /// Exactly as typed by the user — never silently altered.
  birthNameInput       String
  /// The normalized string actually used for letter-value calculation
  /// (`numerology-name.util.ts#normalizeName().display`).
  normalizedBirthName  String
  /// Date-only, `YYYY-MM-DD` semantics enforced at the application layer
  /// (`numerology-date.util.ts`) — stored as a real `DateTime` at UTC midnight.
  birthDate            DateTime
  calculationVersion   String
  normalizationVersion String
  /// AI-narrated interpretation of the real calculated numbers — null until generated,
  /// never a placeholder string in the meantime. A reading is fully real and viewable
  /// (real numbers, real breakdowns) before this exists; interpretation is additive, never
  /// a precondition (mirrors TarotReading's own "interpretation is additive" precedent).
  interpretation       String?
  aiProvider           String?
  aiModel              String?
  promptVersion        String?
  interpretedAt        DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  archivedAt           DateTime?
  deletedAt            DateTime?

  values  NumerologyValue[]
  history NumerologyReadingHistory[]

  @@index([userId, status, createdAt])
  @@map("numerology_readings")
}

/// One row per core number computed for a reading. `breakdown` is the full, structured
/// reduction trail (`NumerologyValueResult['breakdown']` in `numerology-engine.ts`,
/// serialized) — the "why is my number X" transparency data the frontend renders as
/// expandable steps (Sprint 8 brief, Phase 13). Never AI-generated: every row's `value`
/// and `breakdown` come directly from `calculateNumerology()`'s real output.
model NumerologyValue {
  id             String              @id @default(cuid())
  readingId      String
  reading        NumerologyReading   @relation(fields: [readingId], references: [id], onDelete: Cascade)
  type           NumerologyValueType
  value          Int
  isMasterNumber Boolean             @default(false)
  /// Structured calculation steps — see `numerology-engine.ts`'s `DateBasedBreakdown` /
  /// `NameBasedBreakdown` / `DateComponentReduction` shapes.
  breakdown      Json
  /// Only set for PERSONAL_YEAR — the calendar year this value describes (Product Bible
  /// §7/§8: lower-durability, time-bound content). Null for the five permanent numbers.
  appliesToYear  Int?
  /// Display/reveal order within a reading (Overview -> Life Path -> Expression -> Soul
  /// Urge -> Personality -> Birthday -> Personal Year, per Module 15 §4's progressive
  /// disclosure order) — a real, fixed ordering, never client-supplied.
  order          Int

  @@unique([readingId, type])
  @@index([readingId])
  @@map("numerology_values")
}

/// Append-only lifecycle event log — mirrors TarotReadingHistory's own precedent exactly.
model NumerologyReadingHistory {
  id        String                         @id @default(cuid())
  readingId String
  reading   NumerologyReading              @relation(fields: [readingId], references: [id], onDelete: Cascade)
  action    NumerologyReadingHistoryAction
  detail    String
  createdAt DateTime                       @default(now())

  @@index([readingId, createdAt])
  @@map("numerology_reading_history")
}

// ---------------------------------------------------------------------------
// Natal Chart Discovery Foundation (Sprint 9)
// ---------------------------------------------------------------------------

/// Mirrors NumerologyReadingStatus/TarotReadingStatus's own reversible-archive + soft-delete
/// precedent exactly.
enum NatalChartStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

/// Mirrors NumerologyReadingVisibility/TarotReadingVisibility's own PRIVATE/COMPANION_VISIBLE
/// precedent exactly.
enum NatalChartVisibility {
  PRIVATE
  COMPANION_VISIBLE
}

/// Append-only lifecycle event log — mirrors NumerologyReadingHistoryAction's own precedent
/// exactly.
enum NatalChartHistoryAction {
  CREATED
  VIEWED
  INTERPRETED
  ARCHIVED
  RESTORED
  DELETED
}

/// The twelve tropical zodiac signs — shared by placements, houses, and the Ascendant/Midheaven
/// angles so every "what sign is this in" fact in the domain uses one enum.
enum NatalZodiacSign {
  ARIES
  TAURUS
  GEMINI
  CANCER
  LEO
  VIRGO
  LIBRA
  SCORPIO
  SAGITTARIUS
  CAPRICORN
  AQUARIUS
  PISCES
}

/// The ten classical planets computed as `NatalPlacement` rows (Sprint 9 brief's "at minimum"
/// list — lunar nodes/Lilith are out of scope this sprint, see
/// docs/architecture/natal-chart-discovery.md), plus the Ascendant/Midheaven angles, which
/// `NatalChart` stores directly (not as placement rows, since they're singular per chart with no
/// house/retrograde concept) but which still participate in `NatalAspect` as aspect points —
/// hence one shared enum covering both.
enum NatalChartPoint {
  SUN
  MOON
  MERCURY
  VENUS
  MARS
  JUPITER
  SATURN
  URANUS
  NEPTUNE
  PLUTO
  ASCENDANT
  MIDHEAVEN
}

/// Major aspects only (Sprint 9 brief Phase 6) — Conjunction/Opposition/Trine/Square/Sextile.
/// Minor aspects (quincunx, semi-square, etc.) are not computed this sprint.
enum NatalAspectType {
  CONJUNCTION
  OPPOSITION
  TRINE
  SQUARE
  SEXTILE
}

/// A persisted Natal Chart — one deterministic calculation from real, user-submitted birth data,
/// computed once by `NatalChartCalculatorService` and never recalculated after the fact. The full
/// birth input snapshot (`birthDate`/`birthTime`/`birthTimeKnown`) is stored alongside the
/// server-resolved location (`birthPlaceLabel`/`latitude`/`longitude`/`timezone` — never trusted
/// from the client directly, see the Geocoding architecture section of
/// docs/architecture/natal-chart-discovery.md) and the exact calculation configuration
/// (`zodiacMode`/`houseSystem`/`calculationVersion`/`engineVersion`) so a chart is always
/// explainable and reproducible under the rules that actually produced it (Phase 5 versioning).
model NatalChart {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     NatalChartStatus     @default(ACTIVE)
  visibility NatalChartVisibility @default(PRIVATE)

  /// Date-only, `YYYY-MM-DD` semantics enforced at the application layer — stored as a real
  /// `DateTime` at UTC midnight (mirrors `NumerologyReading.birthDate`).
  birthDate       DateTime
  /// `HH:mm`, local to the birth location — null when the user doesn't know their birth time.
  birthTime       String?
  /// Explicit, not merely derived from `birthTime` being null — mirrors the Product Bible's own
  /// `birth_time_known` field name (Module 13 §17's DB sketch) so "time unknown" is always a
  /// first-class, intentional fact, not an inferred one.
  birthTimeKnown  Boolean
  /// Exactly the label the user confirmed from geocoding search results — never silently altered.
  birthPlaceLabel String
  latitude        Float
  longitude       Float
  /// IANA timezone identifier, resolved deterministically from `latitude`/`longitude` (and
  /// corrected for known coarse-geocoder misclassification — see
  /// `natal-chart-timezone.util.ts` — never the browser's current timezone).
  timezone        String

  zodiacMode         String  @default("tropical")
  houseSystem        String  @default("placidus")
  /// False when the house system is mathematically undefined at this latitude (extreme/polar) or
  /// when birth time is unknown — houses/Ascendant/Midheaven are then omitted entirely rather
  /// than fabricated (Phase 6/16 stop-condition).
  housesAvailable    Boolean @default(true)
  calculationVersion String
  /// Pinned `circular-natal-horoscope-js` version actually used, independent of
  /// `calculationVersion` (Sprint 9 brief Phase 5).
  engineVersion      String

  ascendantLongitude    Float?
  ascendantSign         NatalZodiacSign?
  ascendantDegreeInSign Float?
  midheavenLongitude    Float?
  midheavenSign         NatalZodiacSign?
  midheavenDegreeInSign Float?

  /// Structured, section-keyed AI narrative (Phase 11) — null until generated, never a placeholder
  /// in the meantime. A chart is fully real and viewable (real placements, real houses, real
  /// aspects) before this exists; interpretation is additive, never a precondition (mirrors
  /// NumerologyReading's own "interpretation is additive" precedent).
  interpretation Json?
  aiProvider     String?
  aiModel        String?
  promptVersion  String?
  interpretedAt  DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  placements NatalPlacement[]
  houses     NatalHouse[]
  aspects    NatalAspect[]
  history    NatalChartHistory[]

  @@index([userId, status, createdAt])
  @@map("natal_charts")
}

/// One row per computed classical planet. Never AI-generated: every field comes directly from
/// `NatalChartCalculatorService`'s real output.
model NatalPlacement {
  id           String          @id @default(cuid())
  chartId      String
  chart        NatalChart      @relation(fields: [chartId], references: [id], onDelete: Cascade)
  body         NatalChartPoint
  /// Absolute ecliptic longitude, 0-360°.
  longitude    Float
  sign         NatalZodiacSign
  degreeInSign Float
  /// 1-12, null when `NatalChart.housesAvailable` is false.
  house        Int?
  retrograde   Boolean         @default(false)
  /// Fixed classical display order (Sun -> Pluto) — a real, fixed ordering, never client-supplied.
  order        Int

  @@unique([chartId, body])
  @@index([chartId])
  @@map("natal_placements")
}

/// One row per house cusp (1-12) — only present when `NatalChart.housesAvailable` is true.
model NatalHouse {
  id            String          @id @default(cuid())
  chartId       String
  chart         NatalChart      @relation(fields: [chartId], references: [id], onDelete: Cascade)
  number        Int
  cuspLongitude Float
  sign          NatalZodiacSign

  @@unique([chartId, number])
  @@index([chartId])
  @@map("natal_houses")
}

/// One row per detected major aspect between two chart points (planets and/or Ascendant/
/// Midheaven). Deterministic, centralized-orb detection (`natal-chart-constants.ts`) — never a
/// per-request or AI-influenced decision.
model NatalAspect {
  id      String          @id @default(cuid())
  chartId String
  chart   NatalChart      @relation(fields: [chartId], references: [id], onDelete: Cascade)
  pointA  NatalChartPoint
  pointB  NatalChartPoint
  type    NatalAspectType
  /// Degrees of separation from the aspect's exact angle (e.g. 2.3° from an exact Trine).
  orb     Float
  /// The exact angular separation between the two points, 0-180°.
  angle   Float

  @@index([chartId])
  @@map("natal_aspects")
}

/// Append-only lifecycle event log — mirrors NumerologyReadingHistory's own precedent exactly.
model NatalChartHistory {
  id        String                  @id @default(cuid())
  chartId   String
  chart     NatalChart              @relation(fields: [chartId], references: [id], onDelete: Cascade)
  action    NatalChartHistoryAction
  detail    String
  createdAt DateTime                @default(now())

  @@index([chartId, createdAt])
  @@map("natal_chart_history")
}

// ---------------------------------------------------------------------------
// Sprint 11 — Notification & Retention Foundation (Product Bible Module 19, V1 tier — see
// docs/audit/sprint-11-pre-implementation-audit.md and docs/architecture/notification-retention.md).
// Deterministic, silence-by-default: a Notification row is only ever created for a concrete,
// already-real reason (a Daily Tarot draw genuinely still available today, a Premium entitlement
// genuinely just granted) — never an AI judgment call. No push channel this sprint.
// ---------------------------------------------------------------------------

enum NotificationCategory {
  SECURITY
  PREMIUM
  DISCOVERY
}

enum NotificationClass {
  /// Always created and, where email is involved, always sent — never subject to
  /// NotificationPreference (Module 19 §6: "must not accidentally become suppressible").
  TRANSACTIONAL
  /// Reserved for a future non-reminder product-triggered category (Reports-ready, Community
  /// reply, etc.) — defined now so PRODUCT-class notifications don't require a schema change
  /// later, but no Sprint 11 trigger uses it yet (see notification-retention.md "Deliberately
  /// excluded").
  PRODUCT
  /// Opt-in-to-email, visible-by-default-in-app. The only class Sprint 11 actually triggers
  /// (Daily Tarot availability).
  REMINDER
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// One row per notification actually created for a user. Creation itself IS the in-app delivery
/// (its mere existence is what the Notification Center lists) — there is no separate
/// NotificationDelivery table, since only the EMAIL channel can fail independently and needs its
/// own state, which is tracked inline below (`emailStatus`/`emailAttemptedAt`/`emailError`).
/// `@@unique([userId, dedupeKey])` is the real idempotency mechanism (mirrors
/// `PaymentWebhookEvent`'s `@@unique([provider, externalEventId])` precedent exactly) — a
/// scheduler re-run or a concurrent duplicate trigger fails at the DB layer and is treated as a
/// safe no-op, not a distributed lock.
model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  class     NotificationClass
  /// Bounded at the application layer, not the DB — see notifications/notifications.types.ts
  /// `NOTIFICATION_TYPES`. Kept as text rather than a native enum so a new notification type can
  /// ship without a migration, unlike `category`/`class`, which are genuinely closed taxonomies.
  type      String
  title     String
  body      String
  deepLink  String?
  /// Deterministic idempotency key, e.g. `tarot-daily-reminder:2026-08-14` (UTC date) or
  /// `premium-activated:{orderId}`.
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime             @default(now())

  emailStatus      NotificationDeliveryStatus @default(SKIPPED)
  emailAttemptedAt DateTime?
  emailError       String?

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// One row per user, created lazily on first preference read/write (not at registration — most
/// users will never customize this). TRANSACTIONAL-class notifications never consult this table by
/// design (see NotificationClass.TRANSACTIONAL doc comment above).
model NotificationPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderInApp Boolean  @default(true)
  reminderEmail Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("notification_preferences")
}
