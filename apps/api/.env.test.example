# Copy to .env.test for running `pnpm test:e2e` locally against a dedicated test
# database (kept separate from the dev database so e2e runs never touch your
# local dev data). One-time setup:
#   docker exec beaconvie-postgres psql -U beaconvie -d beaconvie -c "CREATE DATABASE beaconvie_test;"
#   DATABASE_URL=postgresql://beaconvie:beaconvie_dev_password@localhost:5433/beaconvie_test?schema=public pnpm --filter @beaconvie/api exec prisma migrate deploy

NODE_ENV=test
API_PORT=4001
API_BASE_URL=http://localhost:4001
FRONTEND_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://beaconvie:beaconvie_dev_password@localhost:5433/beaconvie_test?schema=public
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=test-only-access-secret-not-for-production-use-xxxxx
JWT_REFRESH_SECRET=test-only-refresh-secret-not-for-production-use-xxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CSRF_SECRET=test-only-csrf-secret-not-for-production-use-xxxxxxxxxxx

AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

PASSWORD_RESET_EXPIRES_IN=1h

EMAIL_VERIFICATION_EXPIRES_IN=24h
# Short cooldown so the e2e resend-cooldown test doesn't have to wait a full minute.
EMAIL_VERIFICATION_RESEND_COOLDOWN=2s

EMAIL_PROVIDER=mailpit
EMAIL_FROM="BeaconVie Test <no-reply@beaconvie.local>"
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Higher than the production default so a full e2e run (many register/login/
# forgot-password calls across all spec files) doesn't trip the rate limiter
# itself. Each endpoint has its own bucket (keyed by handler name), so this
# only needs to comfortably exceed the busiest single endpoint's call count
# across the whole suite. Was 200 (calibrated at Sprint 2A for ~35 register
# calls); by Sprint 8 the suite has grown to 15 spec files / 188 tests, most
# of which register their own fresh user (this project's own "unique email
# per test" convention — see e.g. numerology.e2e-spec.ts's uniqueEmail()),
# and the full suite's real register-call volume now exceeds 200, producing
# genuine 429s on /auth/register (reproduced with real evidence: a clean,
# isolated full-suite run against a freshly-flushed Redis still hit 11 real
# 429s across memory.e2e-spec.ts and insight-experience.e2e-spec.ts, both
# unrelated to any product change — see docs/progress/sprint-8-final-report.md
# "Rate-limit / test-isolation finding"). Raised with headroom matching this
# file's own `default`-bucket-equivalent order of magnitude so it doesn't need
# revisiting again as the suite keeps growing.
AUTH_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_REDIS_PREFIX=beaconvie:throttle:test

TRUST_PROXY=false

# Companion Core e2e/unit tests run entirely against the mock provider — no
# real API key needed or used.
DEFAULT_AI_PROVIDER=mock
FALLBACK_PROVIDER=mock
AI_TIMEOUT_MS=5000
AI_MAX_RETRIES=1
# Generous, test-friendly ceilings — same reasoning as AUTH_RATE_LIMIT_MAX
# above: a full e2e/Playwright run sends companion messages across several
# spec files from the same test-runner IP, and this only needs to comfortably
# exceed that total, not reflect a real production limit.
AI_RATE_LIMIT_MAX=200
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_IP_MAX=500
AI_MAX_CONCURRENT_GENERATIONS_PER_USER=1
AI_CONCURRENCY_LOCK_TTL_MS=120000
AI_DAILY_REQUEST_LIMIT=1000
AI_DAILY_TOKEN_LIMIT=200000
AI_MONTHLY_TOKEN_LIMIT=2000000

# Premium & Payment Foundation (Sprint 7) — clearly fake credentials; PAYOS_MOCK_CHECKOUT means no
# real PayOS API call is made during e2e/unit tests, but webhook signature verification is fully
# real (tests sign fixtures with this same checksum key, mirroring PayOS's documented HMAC scheme).
PAYOS_CLIENT_ID=test-only-payos-client-id-not-for-production
PAYOS_API_KEY=test-only-payos-api-key-not-for-production
PAYOS_CHECKSUM_KEY=test-only-payos-checksum-key-not-for-production-xxxxx
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_MOCK_CHECKOUT=true
PAYMENTS_ENABLED=true
PREMIUM_PRICE_VND=79000
PREMIUM_DURATION_DAYS=30
PAYMENT_RATE_LIMIT_MAX=200
PAYMENT_RATE_LIMIT_WINDOW_MS=60000
