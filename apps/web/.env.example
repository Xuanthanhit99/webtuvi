NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Production error tracking (Sprint 12) — optional, error-tracking tier only. Absent = Sentry
# fully disabled, the app builds/runs normally either way. A DSN is a write-only ingestion
# identifier, not a secret — safe to embed in the client bundle by design (NEXT_PUBLIC_ prefix
# required for browser access). See docs/architecture/observability.md.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# --- Product Analytics (Sprint 13) — optional, local/dev off-switch only. There is no client-side
# provider key: every event goes to the BeaconVie API first (POST /analytics/events), which alone
# decides whether/where to forward it (see POSTHOG_API_KEY in apps/api/.env.example). Set to
# "false" to stop this app from even making that call — anything else (including unset) is
# enabled. See docs/architecture/product-analytics.md.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
