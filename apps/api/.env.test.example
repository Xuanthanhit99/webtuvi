# Copy to .env.test for running `pnpm test:e2e` locally against a dedicated test
# database (kept separate from the dev database so e2e runs never touch your
# local dev data). One-time setup:
#   docker exec beaconvie-postgres psql -U beaconvie -d beaconvie -c "CREATE DATABASE beaconvie_test;"
#   DATABASE_URL=postgresql://beaconvie:beaconvie_dev_password@localhost:5433/beaconvie_test?schema=public pnpm --filter @beaconvie/api exec prisma migrate deploy

NODE_ENV=test
API_PORT=4001
API_BASE_URL=http://localhost:4001
FRONTEND_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://beaconvie:beaconvie_dev_password@localhost:5433/beaconvie_test?schema=public
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=test-only-access-secret-not-for-production-use-xxxxx
JWT_REFRESH_SECRET=test-only-refresh-secret-not-for-production-use-xxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CSRF_SECRET=test-only-csrf-secret-not-for-production-use-xxxxxxxxxxx

AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

PASSWORD_RESET_EXPIRES_IN=1h

EMAIL_VERIFICATION_EXPIRES_IN=24h
# Short cooldown so the e2e resend-cooldown test doesn't have to wait a full minute.
EMAIL_VERIFICATION_RESEND_COOLDOWN=2s

EMAIL_PROVIDER=mailpit
EMAIL_FROM="BeaconVie Test <no-reply@beaconvie.local>"
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Higher than the production default so a full e2e run (many register/login/
# forgot-password calls across all spec files) doesn't trip the rate limiter
# itself. Each endpoint has its own bucket (keyed by handler name), so this
# only needs to comfortably exceed the busiest single endpoint's call count
# across the whole suite (register: ~35 across all spec files as of Sprint 2A).
AUTH_RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_REDIS_PREFIX=beaconvie:throttle:test

TRUST_PROXY=false

# Companion Core e2e/unit tests run entirely against the mock provider — no
# real API key needed or used.
DEFAULT_AI_PROVIDER=mock
FALLBACK_PROVIDER=mock
AI_TIMEOUT_MS=5000
AI_MAX_RETRIES=1
